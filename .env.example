# 복사해서 .env.local로 만들고 값을 채운다: cp .env.example .env.local
MONGODB_URI=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
EMAIL_CODE_HMAC_KEY=
RESEND_API_KEY=
MAIL_FROM=
ADMIN_EMAILS=

# (선택) 관리자 대시보드 '최근 배포' 목록. 없으면 그 칸만 안내 문구로 보인다.
# Vercel → Account Settings → Tokens에서 만든 토큰 / 프로젝트 Settings → General의 Project ID
# 팀 프로젝트면 VERCEL_TEAM_ID도 (Team Settings → General의 Team ID)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
